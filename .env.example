# Local defaults. Copy to .env and change every secret before any shared environment.
# Ports avoid a stock Superset already bound to 8088.

POSTGRES_PASSWORD=change-me-postgres
SUPERSET_DB_PASSWORD=change-me-superset-meta
ANALYTICS_RO_PASSWORD=change-me-analytics-ro
POSTGRES_PORT=5444

SUPERSET_SECRET_KEY=change-me-superset-secret-key-at-least-32-chars
GUEST_TOKEN_JWT_SECRET=change-me-guest-token-secret-at-least-32
GUEST_TOKEN_JWT_EXP_SECONDS=300

SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me-admin
SUPERSET_ADMIN_EMAIL=admin@localhost

GUEST_TOKEN_SERVICE_USERNAME=guest_token_service
GUEST_TOKEN_SERVICE_PASSWORD=change-me-guest-token-service

SUPERSET_PUBLISH_PORT=8100
HOST_APP_PORT=8101
SUPERSET_PUBLIC_URL=http://localhost:8100
SUPERSET_INTERNAL_URL=http://superset:8088
HOST_APP_ORIGINS=http://localhost:8101
HOST_APP_SECRET=change-me-host-app-secret
HOST_APP_COOKIE_SECURE=false
DASHBOARD_SLUG=sales-jalali

# Local HTTP cannot use SameSite=None without Secure.
SUPERSET_SESSION_COOKIE_SAMESITE=Lax
SUPERSET_SESSION_COOKIE_SECURE=false

TALISMAN_ENABLED=true
JALALI_DATEFILTER_ENABLED=true
# main serves the Jalali picker. hello is the Milestone 0 probe button.
JALALI_DATEFILTER_BUNDLE=main
JALALI_BLUEPRINT_ENABLED=true
JALALI_SQL_MIN_YEAR=1390
JALALI_SQL_MAX_YEAR=1420

SERVER_WORKER_AMOUNT=2
REDIS_URL=redis://redis:6379/0
